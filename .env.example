# Single key via environment (CI, scripts)
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000   # omit for Individual keys
ASC_KEY_ID=ABC123DEFG
ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_ABC123DEFG.p8
# or the PEM itself, with \n escapes:
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
ASC_VENDOR_NUMBER=12345678                            # sales and finance reports
ASC_APP_ID=1234567890                                 # default --app

# Hosted server (packages/server)
APPEEKY_API_URL=https://api.appeeky.com
STORE_GATEWAY_SECRET=change-me
PORT=8080

# Multi-account config lives in ~/.config/appstore/config.json:
#
# {
#   "defaultAccount": "my-team",
#   "accounts": {
#     "my-team": {
#       "issuerId": "00000000-0000-0000-0000-000000000000",
#       "keyId": "ABC123DEFG",
#       "privateKeyPath": "/absolute/path/to/AuthKey_ABC123DEFG.p8",
#       "vendorNumber": "12345678",
#       "defaultAppId": "1234567890",
#       "apps": [{ "appId": "1234567890", "bundleId": "com.example.app", "name": "Example" }]
#     },
#     "client-acme": {
#       "keyId": "XYZ987WVUT",
#       "privateKeyPath": "/absolute/path/to/AuthKey_XYZ987WVUT.p8"
#     }
#   }
# }
